/**
 * OIDC client discovery and per-request PKCE material.
 *
 * openid-client v6 validates the ID token signature, ES256 algorithm, issuer,
 * audience, nonce, and expiry during authorizationCodeGrant().
 */
import {
  ClientSecretBasic,
  calculatePKCECodeChallenge,
  discovery,
  enableNonRepudiationChecks,
  randomNonce,
  randomPKCECodeVerifier,
  randomState,
  type Configuration,
} from "openid-client";

import { loadOidcConfig } from "./config.js";

let clientPromise: Promise<Configuration> | undefined;

/** Discover and memoise the issuer and confidential-client configuration. */
export function getClient(): Promise<Configuration> {
  if (!clientPromise) {
    clientPromise = (async () => {
      const config = loadOidcConfig();
      const configuration = await discovery(
        new URL(config.issuerUrl),
        config.clientId,
        {
          client_secret: config.clientSecret,
          redirect_uris: [config.redirectUrl],
          response_types: ["code"],
          token_endpoint_auth_method: "client_secret_basic",
          id_token_signed_response_alg: "ES256",
        },
        ClientSecretBasic(config.clientSecret),
      );
      enableNonRepudiationChecks(configuration);
      return configuration;
    })().catch((error) => {
      clientPromise = undefined;
      throw error;
    });
  }
  return clientPromise;
}

export interface AuthRequestState {
  readonly state: string;
  readonly nonce: string;
  readonly codeVerifier: string;
  readonly codeChallenge: string;
}

/** Generate PKCE, state, and nonce values for one authorization request. */
export async function createAuthRequestState(): Promise<AuthRequestState> {
  const codeVerifier = randomPKCECodeVerifier();
  return {
    state: randomState(),
    nonce: randomNonce(),
    codeVerifier,
    codeChallenge: await calculatePKCECodeChallenge(codeVerifier),
  };
}
