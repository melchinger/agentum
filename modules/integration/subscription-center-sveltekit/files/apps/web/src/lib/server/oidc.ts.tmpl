import { SignJWT, jwtVerify } from "jose";
import { Issuer, generators, type Client, type TokenSet } from "openid-client";
import type { AppUser } from "./config";
import { getConfig, sessionKey, stripSpn } from "./config";

/**
 * KanIDM OIDC integration built on `openid-client` (v5).
 *
 * `openid-client` performs discovery of
 * `{OPENID_ISSUER_URL}/.well-known/openid-configuration`, PKCE (S256) and full
 * id_token validation against the JWKS (alg ES256, aud=client_id, iss=issuer,
 * nonce match, exp) inside `client.callback()`.
 */

const STATE_COOKIE = "sc_oidc_state";

let clientPromise: Promise<Client> | null = null;

/** Discover the issuer once and build a confidential (client_secret) client. */
export async function getClient(): Promise<Client> {
  if (!clientPromise) {
    clientPromise = (async () => {
      const cfg = getConfig();
      const issuer = await Issuer.discover(cfg.issuerUrl);
      return new issuer.Client({
        client_id: cfg.clientId,
        client_secret: cfg.clientSecret,
        redirect_uris: [cfg.redirectUrl],
        response_types: ["code"],
        // Confidential client: authenticate the token exchange with the secret.
        token_endpoint_auth_method: "client_secret_basic"
      });
    })().catch((error) => {
      clientPromise = null;
      throw error;
    });
  }
  return clientPromise;
}

export interface AuthRequest {
  redirectUrl: string;
  stateCookie: string;
}

/**
 * Build the authorize redirect URL and a signed, short-lived cookie carrying
 * {state, nonce, verifier} so the callback can validate the round-trip.
 */
export async function buildAuthRequest(): Promise<AuthRequest> {
  const cfg = getConfig();
  const client = await getClient();

  const state = generators.state();
  const nonce = generators.nonce();
  const verifier = generators.codeVerifier();
  const challenge = generators.codeChallenge(verifier);

  const redirectUrl = client.authorizationUrl({
    response_type: "code",
    scope: cfg.scopes,
    state,
    nonce,
    code_challenge: challenge,
    code_challenge_method: "S256",
    redirect_uri: cfg.redirectUrl
  });

  const stateCookie = await new SignJWT({ state, nonce, verifier })
    .setProtectedHeader({ alg: "HS256" })
    .setIssuedAt()
    .setExpirationTime("10m")
    .sign(sessionKey());

  return { redirectUrl, stateCookie };
}

interface StateClaims {
  state: string;
  nonce: string;
  verifier: string;
}

async function readStateCookie(value: string): Promise<StateClaims | null> {
  try {
    const { payload } = await jwtVerify(value, sessionKey());
    if (
      typeof payload.state === "string" &&
      typeof payload.nonce === "string" &&
      typeof payload.verifier === "string"
    ) {
      return { state: payload.state, nonce: payload.nonce, verifier: payload.verifier };
    }
    return null;
  } catch {
    return null;
  }
}

function toUser(tokenSet: TokenSet): AppUser {
  const claims = tokenSet.claims();
  const preferred = typeof claims.preferred_username === "string" ? claims.preferred_username : "";
  const uid = preferred ? stripSpn(preferred) : String(claims.sub);
  const rawGroups = Array.isArray(claims.groups) ? (claims.groups as unknown[]) : [];
  const groups = rawGroups
    .filter((g): g is string => typeof g === "string")
    .map((g) => stripSpn(g));
  return { uid, groups };
}

/**
 * Verify the state cookie, exchange the code as a confidential client and
 * validate the id_token. Returns the resolved application user.
 */
export async function handleCallback(
  params: Record<string, string>,
  stateCookieValue: string | undefined
): Promise<AppUser> {
  const cfg = getConfig();
  const client = await getClient();

  const stateClaims = stateCookieValue ? await readStateCookie(stateCookieValue) : null;
  if (!stateClaims) {
    throw new Error("Missing or invalid OIDC state cookie.");
  }
  if (params.state !== stateClaims.state) {
    throw new Error("OIDC state mismatch.");
  }

  const tokenSet = await client.callback(cfg.redirectUrl, params, {
    state: stateClaims.state,
    nonce: stateClaims.nonce,
    code_verifier: stateClaims.verifier
  });

  return toUser(tokenSet);
}

export const OIDC_STATE_COOKIE = STATE_COOKIE;
