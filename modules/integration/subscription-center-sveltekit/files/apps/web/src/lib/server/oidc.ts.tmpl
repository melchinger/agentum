import { SignJWT, jwtVerify } from "jose";
import {
  ClientSecretBasic,
  authorizationCodeGrant,
  buildAuthorizationUrl,
  calculatePKCECodeChallenge,
  discovery,
  enableNonRepudiationChecks,
  randomNonce,
  randomPKCECodeVerifier,
  randomState,
  type Configuration
} from "openid-client";
import type { AppUser } from "./config";
import { getConfig, sessionKey, stripSpn } from "./config";

/**
 * KanIDM OIDC integration built on openid-client v6. Discovery and the code
 * grant enforce PKCE and validate the ID token's ES256 signature, issuer,
 * audience, nonce, and expiry.
 */
const STATE_COOKIE = "sc_oidc_state";
let clientPromise: Promise<Configuration> | null = null;

/** Discover the issuer once and configure a confidential client. */
export async function getClient(): Promise<Configuration> {
  if (!clientPromise) {
    clientPromise = (async () => {
      const cfg = getConfig();
      const configuration = await discovery(
        new URL(cfg.issuerUrl),
        cfg.clientId,
        {
          client_secret: cfg.clientSecret,
          redirect_uris: [cfg.redirectUrl],
          response_types: ["code"],
          token_endpoint_auth_method: "client_secret_basic",
          id_token_signed_response_alg: "ES256"
        },
        ClientSecretBasic(cfg.clientSecret)
      );
      enableNonRepudiationChecks(configuration);
      return configuration;
    })().catch((error) => {
      clientPromise = null;
      throw error;
    });
  }
  return clientPromise;
}

export interface AuthRequest {
  redirectUrl: string;
  stateCookie: string;
}

/** Build an authorization URL and a signed, short-lived state cookie. */
export async function buildAuthRequest(): Promise<AuthRequest> {
  const cfg = getConfig();
  const client = await getClient();
  const state = randomState();
  const nonce = randomNonce();
  const verifier = randomPKCECodeVerifier();
  const challenge = await calculatePKCECodeChallenge(verifier);

  const redirectUrl = buildAuthorizationUrl(client, {
    response_type: "code",
    scope: cfg.scopes,
    state,
    nonce,
    code_challenge: challenge,
    code_challenge_method: "S256",
    redirect_uri: cfg.redirectUrl
  });

  const stateCookie = await new SignJWT({ state, nonce, verifier })
    .setProtectedHeader({ alg: "HS256" })
    .setIssuedAt()
    .setExpirationTime("10m")
    .sign(sessionKey());

  return { redirectUrl: redirectUrl.href, stateCookie };
}

interface StateClaims {
  state: string;
  nonce: string;
  verifier: string;
}

async function readStateCookie(value: string): Promise<StateClaims | null> {
  try {
    const { payload } = await jwtVerify(value, sessionKey());
    if (
      typeof payload.state === "string" &&
      typeof payload.nonce === "string" &&
      typeof payload.verifier === "string"
    ) {
      return { state: payload.state, nonce: payload.nonce, verifier: payload.verifier };
    }
    return null;
  } catch {
    return null;
  }
}

function toUser(tokenSet: Awaited<ReturnType<typeof authorizationCodeGrant>>): AppUser {
  const claims = tokenSet.claims();
  if (!claims) {
    throw new Error("OIDC token endpoint did not return a validated ID token.");
  }
  const preferred = typeof claims.preferred_username === "string" ? claims.preferred_username : "";
  const uid = preferred ? stripSpn(preferred) : stripSpn(claims.sub);
  const rawGroups = Array.isArray(claims.groups) ? (claims.groups as unknown[]) : [];
  const groups = rawGroups
    .filter((group): group is string => typeof group === "string")
    .map((group) => stripSpn(group));
  return { uid, groups };
}

/** Validate state, exchange the code, and resolve the application user. */
export async function handleCallback(
  currentUrl: URL,
  stateCookieValue: string | undefined
): Promise<AppUser> {
  const client = await getClient();
  const stateClaims = stateCookieValue ? await readStateCookie(stateCookieValue) : null;
  if (!stateClaims) {
    throw new Error("Missing or invalid OIDC state cookie.");
  }

  const tokenSet = await authorizationCodeGrant(client, currentUrl, {
    expectedState: stateClaims.state,
    expectedNonce: stateClaims.nonce,
    pkceCodeVerifier: stateClaims.verifier,
    idTokenExpected: true
  });
  return toUser(tokenSet);
}

export const OIDC_STATE_COOKIE = STATE_COOKIE;
