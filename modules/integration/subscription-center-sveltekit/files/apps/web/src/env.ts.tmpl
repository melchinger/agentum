import { defineEnvVars } from "@sveltejs/kit/env";

const optional = (value: string | undefined): string | undefined => value;

export const variables = defineEnvVars({
  OPENID_ENABLED: { schema: optional },
  OPENID_ISSUER_URL: { schema: optional },
  OPENID_CLIENT_ID: { schema: optional },
  OPENID_CLIENT_SECRET: { schema: optional },
  OPENID_REDIRECT_URL: { schema: optional },
  OPENID_SCOPES: { schema: optional },
  OPENID_ADMIN_GROUP: { schema: optional },
  SESSION_SECRET: { schema: optional },
  SESSION_KILL_SECRET: { schema: optional }
});
