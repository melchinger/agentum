{
  "name": "subscription-center-rust",
  "category": "integration",
  "description": "KanIDM-OIDC-Anbindung (Authorization Code + PKCE) an subscriptionCenter für Axum-Services: Login, Gruppen→Rollen-Autorisierung und Session-Kill-Webhook. Additiv über die rust-Runtime.",
  "compatibleRuntimes": ["rust"],
  "requiresModules": ["axum"],
  "cargoDependencies": {
    "axum": "0.8",
    "tokio": { "version": "1", "features": ["macros", "rt-multi-thread"] },
    "reqwest": { "version": "0.13", "default-features": false, "features": ["json", "rustls"] },
    "serde": { "version": "1", "features": ["derive"] },
    "serde_json": "1",
    "jsonwebtoken": { "version": "11", "default-features": false, "features": ["rust_crypto"] },
    "sha2": "0.11",
    "base64": "0.23",
    "url": "2.5",
    "getrandom": "0.4",
    "tracing": "0.1"
  },
  "directories": [
    "src/auth",
    "docs"
  ],
  "requiredFiles": [
    "src/auth/mod.rs",
    "src/auth/config.rs",
    "src/auth/oidc.rs",
    "src/auth/session.rs",
    "src/auth/router.rs",
    "docs/subscription-center.md"
  ],
  "env": [
    "OPENID_ENABLED=true",
    "OPENID_ISSUER_URL=https://id.ch01.melchinger.net/oauth2/openid/CHANGE_ME",
    "OPENID_CLIENT_ID=CHANGE_ME",
    "OPENID_CLIENT_SECRET=CHANGE_ME",
    "OPENID_REDIRECT_URL=http://localhost:8080/auth/callback",
    "OPENID_SCOPES=openid email profile groups",
    "OPENID_ADMIN_GROUP=",
    "SESSION_SECRET=change-me-generate-a-random-32-byte-secret",
    "SESSION_KILL_SECRET=change-me-shared-with-subscriptioncenter"
  ],
  "detect": {
    "packageIndicators": ["jsonwebtoken"]
  }
}
