"""Session-kill webhook receiver.

Mirrors the WordPress ``POST /wp-json/openid-role-mapper/v1/session-kill`` contract
exactly: the subscriptionCenter service calls this endpoint with a shared bearer
secret to force-log-out a user (e.g. after a subscription is revoked).
"""

from __future__ import annotations

import hmac
import logging

from fastapi import APIRouter, Header, Response, status
from fastapi.exceptions import HTTPException
from pydantic import BaseModel

from .config import get_settings
from .session import get_session_manager

logger = logging.getLogger(__name__)

session_kill_router = APIRouter(tags=["auth"])


class SessionKillRequest(BaseModel):
    uid: str


def _authorize(authorization: str | None) -> None:
    settings = get_settings()
    expected = f"Bearer {settings.session_kill_secret}"
    # Constant-time compare so the shared secret cannot be probed by timing.
    if not authorization or not hmac.compare_digest(authorization, expected):
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="invalid session-kill token")


@session_kill_router.post("/internal/session-kill", status_code=status.HTTP_204_NO_CONTENT)
async def session_kill(
    payload: SessionKillRequest,
    authorization: str | None = Header(default=None),
) -> Response:
    _authorize(authorization)
    killed = get_session_manager().kill_all(payload.uid)
    logger.info("session-kill for uid=%s removed %d session(s)", payload.uid, killed)
    return Response(status_code=status.HTTP_204_NO_CONTENT)
