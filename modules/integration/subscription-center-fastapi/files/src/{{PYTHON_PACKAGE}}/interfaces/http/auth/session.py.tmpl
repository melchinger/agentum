"""Signed-cookie session handling plus the in-memory active-session registry.

The browser holds a signed (itsdangerous) cookie carrying the session id, uid and
groups. The server keeps an authoritative registry mapping ``uid -> {session_id}``
so that the ``/internal/session-kill`` webhook can invalidate *all* sessions of a
user: a cookie whose session id is no longer registered is treated as logged out.

NOTE: the registry is a plain in-process dict. Swap it for Redis (or another shared
store) in production so that session-kill and login work across multiple workers.
"""

from __future__ import annotations

import logging
import secrets
from dataclasses import dataclass, field

from itsdangerous import BadSignature, SignatureExpired, URLSafeTimedSerializer

from .config import OidcSettings, get_settings

logger = logging.getLogger(__name__)

SESSION_COOKIE = "sc_session"
# Sessions live at most 12 hours before the signed cookie is rejected.
SESSION_MAX_AGE_SECONDS = 12 * 60 * 60


@dataclass(frozen=True)
class Principal:
    """The authenticated user extracted from a valid session cookie."""

    uid: str
    groups: frozenset[str] = field(default_factory=frozenset)

    def in_group(self, name: str) -> bool:
        return name in self.groups


class SessionManager:
    """Creates, validates and revokes browser sessions."""

    def __init__(self, secret: str) -> None:
        # A dedicated salt keeps this serializer independent from the flow cookie.
        self._serializer = URLSafeTimedSerializer(secret or "insecure-dev-secret", salt="sc-session")
        # uid -> set of active session ids. Swap for Redis in production.
        self._active: dict[str, set[str]] = {}

    def create(self, uid: str, groups: frozenset[str]) -> str:
        """Register a new session and return the signed cookie value."""

        session_id = secrets.token_urlsafe(24)
        self._active.setdefault(uid, set()).add(session_id)
        return self._serializer.dumps({"sid": session_id, "uid": uid, "groups": sorted(groups)})

    def resolve(self, cookie_value: str | None) -> Principal | None:
        """Return the Principal for a cookie, or ``None`` if invalid/revoked."""

        if not cookie_value:
            return None
        try:
            payload = self._serializer.loads(cookie_value, max_age=SESSION_MAX_AGE_SECONDS)
        except SignatureExpired:
            logger.info("Rejected expired session cookie")
            return None
        except BadSignature:
            logger.warning("Rejected session cookie with bad signature")
            return None

        uid = payload.get("uid")
        session_id = payload.get("sid")
        if not uid or not session_id:
            return None
        if session_id not in self._active.get(uid, set()):
            # Session was killed (or the server restarted) -> treat as logged out.
            return None
        return Principal(uid=uid, groups=frozenset(payload.get("groups", [])))

    def destroy(self, cookie_value: str | None) -> None:
        """Invalidate the single session encoded in ``cookie_value``."""

        if not cookie_value:
            return
        try:
            payload = self._serializer.loads(cookie_value, max_age=SESSION_MAX_AGE_SECONDS)
        except (BadSignature, SignatureExpired):
            return
        uid = payload.get("uid")
        session_id = payload.get("sid")
        active = self._active.get(uid)
        if active and session_id in active:
            active.discard(session_id)
            if not active:
                self._active.pop(uid, None)

    def kill_all(self, uid: str) -> int:
        """Invalidate every session of ``uid``. Returns the number removed."""

        removed = self._active.pop(uid, set())
        if removed:
            logger.info("Killed %d session(s) for uid=%s", len(removed), uid)
        return len(removed)


_manager: SessionManager | None = None


def get_session_manager(settings: OidcSettings | None = None) -> SessionManager:
    """Return the process-wide singleton session manager."""

    global _manager
    if _manager is None:
        active = settings or get_settings()
        _manager = SessionManager(active.session_secret)
    return _manager
