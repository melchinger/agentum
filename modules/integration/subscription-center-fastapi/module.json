{
  "name": "subscription-center-fastapi",
  "category": "integration",
  "description": "SubscriptionCenter-Anbindung fuer FastAPI: KanIDM-OIDC-Login (PKCE, ES256), Gruppen-basierte Autorisierung und Session-Kill-Webhook.",
  "compatibleRuntimes": ["python"],
  "requiresModules": ["fastapi"],
  "directories": [
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth",
    "docs"
  ],
  "requiredFiles": [
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth/__init__.py",
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth/config.py",
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth/oidc.py",
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth/session.py",
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth/session_kill.py",
    "src/{{PYTHON_PACKAGE}}/interfaces/http/auth/router.py",
    "docs/subscription-center.md"
  ],
  "env": [
    "OPENID_ENABLED=true",
    "OPENID_ISSUER_URL=https://id.ch01.melchinger.net/oauth2/openid/CHANGE_ME",
    "OPENID_CLIENT_ID=CHANGE_ME",
    "OPENID_CLIENT_SECRET=CHANGE_ME",
    "OPENID_REDIRECT_URL=http://localhost:8000/auth/callback",
    "OPENID_SCOPES=openid email profile groups",
    "OPENID_ADMIN_GROUP=",
    "SESSION_SECRET=change-me-generate-a-random-32-byte-secret",
    "SESSION_KILL_SECRET=change-me-shared-with-subscriptioncenter"
  ],
  "detect": {
    "packageIndicators": ["pyjwt", "itsdangerous"]
  }
}
