{
  "name": "sveltekit-static",
  "category": "frontend",
  "description": "SvelteKit 3 with adapter-static for Tauri or CDN-hosted frontends. Prerendered, no server runtime.",
  "compatibleRuntimes": ["node", "rust"],
  "conflictsWith": ["nextjs", "sveltekit", "socketio-session", "boardgame-io-core"],
  "directories": [
    "src/routes",
    "src/lib"
  ],
  "requiredFiles": [
    "src/app.html",
    "vite.config.ts",
    "package.json"
  ],
  "commands": [
    "dev: npm run dev",
    "build: npm run build",
    "preview: npm run preview"
  ],
  "detect": {
    "packageIndicators": ["@sveltejs/adapter-static"]
  }
}
