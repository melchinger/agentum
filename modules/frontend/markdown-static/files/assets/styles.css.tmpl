/* Minimal base styles for the static site. Restyle freely — this is scaffolding. */

:root {
  /* Design tokens: change this block to rebrand the site without touching content or templates. */
  --ink: #1a1a1a;
  --muted: #5a5a5a;
  --accent: #1e6663;
  --on-accent: #ffffff;
  --bg: #ffffff;
  --surface: #ffffff;
  --surface-soft: #f5faf9;
  --line: #e4e4e4;
  --error: #b3261e;
  --radius: 10px;
  --maxw: 720px;
  --font-body: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  --font-size-body: 16px;
  --line-height-body: 1.65;
  --space-xs: 6px;
  --space-sm: 10px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 40px;
  --space-hero: 56px;
}

* { box-sizing: border-box; }

img { max-width: 100%; height: auto; }

:focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 3px;
}

body {
  margin: 0;
  color: var(--ink);
  background: var(--bg);
  font: var(--font-size-body)/var(--line-height-body) var(--font-body);
}

.container { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 var(--space-lg); }

a { color: var(--accent); }

.site-header { border-bottom: 1px solid var(--line); }
.site-header .container { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); padding-top: var(--space-md); padding-bottom: var(--space-md); }
.brand { font-weight: 700; text-decoration: none; color: var(--ink); }
.main-nav ul { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; }
.main-nav a { text-decoration: none; color: var(--muted); }
.main-nav a[aria-current="page"] { color: var(--ink); font-weight: 600; }

@media (max-width: 700px) {
  .site-header .container { align-items: flex-start; flex-direction: column; }
  .main-nav ul { flex-wrap: wrap; gap: var(--space-sm) var(--space-md); }
}

.hero { padding: var(--space-hero) 0 var(--space-lg); }
.hero .eyebrow { display: inline-block; color: var(--accent); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; font-size: .8rem; }
.hero h1 { margin: 8px 0 12px; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.15; }
.hero .lede { color: var(--muted); font-size: 1.1rem; margin: 0; }

.section { padding: var(--space-lg) 0 var(--space-xl); }
.prose > :first-child { margin-top: 0; }

.site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
.site-footer .container { padding-top: 28px; padding-bottom: 28px; }
.footer-legal { margin-bottom: 0; }

/* --- Contact form (shared by the forms modules) --- */
.contact-form { display: grid; gap: 16px; max-width: 520px; }
.field { display: grid; gap: 6px; }
.field label { font-weight: 600; font-size: .95rem; }
.field input,
.field select,
.field textarea {
  font: inherit;
  padding: var(--space-sm) 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--ink);
}
.field textarea { min-height: 140px; resize: vertical; }
.field--check { grid-template-columns: auto 1fr; align-items: start; gap: 10px; }
.field--check label { font-weight: 400; }
/* Honeypot: hidden from humans, tempting to bots. */
.hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

.btn {
  display: inline-block;
  border: 0;
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--on-accent);
  font: inherit;
  font-weight: 600;
  padding: 12px 22px;
  cursor: pointer;
}
.btn[disabled] { opacity: .6; cursor: progress; }

.form-status { margin: 0; }
.form-status.is-error { color: var(--error); }
.form-thanks { padding: var(--space-md); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-soft); }
.form-hint { color: var(--muted); font-size: .85rem; margin: 0; }
