// Generic page template: optional hero, rendered Markdown, and an optional
// data-driven form supplied by an exclusive forms module.

const fs = require("node:fs");
const path = require("node:path");

const esc = (value = "") =>
  String(value)
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

const contactFormPath = path.join(__dirname, "contact-form.js");
const contactForm = fs.existsSync(contactFormPath) ? require(contactFormPath) : null;

function heroHtml(p) {
  if (!p.hero_title && !p.title) return "";
  return `<section class="hero">
  <div class="container">
    ${p.eyebrow ? `<span class="eyebrow">${esc(p.eyebrow)}</span>` : ""}
    <h1>${esc(p.hero_title || p.title)}</h1>
    ${p.hero_sub ? `<p class="lede">${esc(p.hero_sub)}</p>` : ""}
  </div>
</section>`;
}

module.exports = function page(site, p) {
  const parts = [heroHtml(p)];

  if (p.body_html && p.body_html.trim()) {
    parts.push(`<section class="section">
  <div class="container">
    <div class="prose">
${p.body_html}
    </div>
  </div>
</section>`);
  }

  if (p.form && contactForm) {
    parts.push(`<section class="section">
  <div class="container">
${contactForm(p.form)}
  </div>
</section>`);
  }

  return parts.filter(Boolean).join("\n\n");
};
