{
  "name": "markdown-static",
  "category": "frontend",
  "description": "Zero-framework static site generator. Content lives in content/*.md (front matter + Markdown), templates are plain JS functions, and `node build.js` renders static HTML into dist/. Editable by non-developers, deployable as flat files.",
  "compatibleRuntimes": ["node"],
  "conflictsWith": [
    "nextjs",
    "react",
    "svelte",
    "sveltekit",
    "sveltekit-static",
    "htmx",
    "socketio-react",
    "boardgame-io-react"
  ],
  "npmDependencies": {
    "dependencies": {
      "marked": "^18.1.0",
      "yaml": "^2.9.1"
    }
  },
  "npmScripts": {
    "build": "node build.js"
  },
  "directories": [
    "content",
    "templates",
    "assets"
  ],
  "requiredFiles": [
    "build.js",
    "content/site.md",
    "content/index.md",
    "content/privacy.md",
    "assets/styles.css",
    "assets/_headers",
    "assets/.htaccess",
    "templates/layout.js",
    "templates/page.js",
    "templates/contact-form-renderer.js",
    "docs/static-deployment.md"
  ],
  "commands": [
    "build: node build.js",
    "dev: node --watch build.js"
  ],
  "detect": {
    "files": ["build.js"],
    "packageIndicators": ["marked", "yaml"]
  }
}
