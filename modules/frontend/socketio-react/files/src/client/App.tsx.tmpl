import { useEffect, useRef, useState } from 'react';
import type { Socket } from 'socket.io-client';
import type {
  ClientToServerEvents,
  Role,
  ServerToClientEvents,
  SessionView,
} from '../shared/types';
import { connectSession } from './socket';

// In a real app the token (and the role it encodes) come from your auth flow.
// Here they are read from the URL for a quick two-window demo:
//   ?token=COACH_TOKEN&role=coach   |   ?token=COACHEE_TOKEN&role=coachee
const params = new URLSearchParams(window.location.search);
const token = params.get('token') ?? '';
const role = (params.get('role') as Role | null) ?? 'coachee';

export function App() {
  const socketRef = useRef<Socket<ServerToClientEvents, ClientToServerEvents> | null>(null);
  const [view, setView] = useState<SessionView | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const socket = connectSession(token);
    socketRef.current = socket;
    socket.on('state', setView);
    socket.on('session:error', setError);
    return () => {
      socket.disconnect();
    };
  }, []);

  if (!view) {
    return <main>Connecting…</main>;
  }

  return (
    <main>
      <h1>{{PROJECT_NAME}}</h1>
      <p>
        Role: {role} — phase: {view.phase}
      </p>
      {error && <p role="alert">{error}</p>}

      {role === 'coach' && view.phase === 'setup' && (
        <button
          onClick={() =>
            socketRef.current?.emit('session:configure', [{ deckId: 'tarot', count: 3 }])
          }
        >
          Draw 3 from tarot
        </button>
      )}

      <ul>
        {view.slots.map((slot) => (
          <li key={slot.id}>
            {slot.revealed ? slot.cardId : '🂠 facedown'}{' '}
            {role === 'coachee' && !slot.revealed && (
              <button onClick={() => socketRef.current?.emit('slot:reveal', { slotId: slot.id })}>
                Reveal
              </button>
            )}
          </li>
        ))}
      </ul>
    </main>
  );
}
