chrome.runtime.onInstalled.addListener((details) => {
  console.log("[{{PROJECT_SLUG}}] installed", details.reason);
});

chrome.runtime.onStartup.addListener(() => {
  console.log("[{{PROJECT_SLUG}}] startup");
});

chrome.runtime.onMessage.addListener((message, _sender, sendResponse) => {
  // Replace with a typed discriminated-union message handler.
  console.log("[{{PROJECT_SLUG}}] message", message);
  sendResponse({ ok: true });
  return true;
});
