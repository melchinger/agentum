export type Role = 'coach' | 'coachee';
export type Phase = 'setup' | 'drawing' | 'active' | 'closed';

export interface Slot {
  id: string;
  deckId: string;
  cardId: string; // secret until revealed
  revealed: boolean;
}

/** Full server-held state. `decks` and unrevealed `cardId`s never leave the server. */
export interface SessionState {
  phase: Phase;
  decks: Record<string, string[]>; // deckId -> remaining cardIds (server only)
  slots: Slot[];
}

/**
 * What a client is allowed to see. Identical for both roles — the only secret
 * is an unrevealed card. Asymmetric content (e.g. an almanac) is fetched
 * out-of-band by cardId, never carried here.
 */
export interface SessionView {
  phase: Phase;
  slots: Array<{ id: string; deckId: string; revealed: boolean; cardId: string | null }>;
}

export interface DrawRequest {
  deckId: string;
  count: number;
}

export interface ClientToServerEvents {
  'session:configure': (draws: DrawRequest[]) => void;
  'slot:reveal': (payload: { slotId: string }) => void;
  'session:close': () => void;
}

export interface ServerToClientEvents {
  state: (view: SessionView) => void;
  'session:error': (message: string) => void;
}

export interface SocketData {
  sessionId: string;
  role: Role;
}
