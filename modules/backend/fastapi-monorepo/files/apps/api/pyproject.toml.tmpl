[build-system]
requires = ["setuptools>=84,<86"]
build-backend = "setuptools.build_meta"

[project]
name = "{{PROJECT_SLUG}}-api"
version = "0.1.0"
description = "Generated FastAPI backend for {{PROJECT_NAME}}"
requires-python = ">=3.14"
dependencies = [
    "fastapi>=0.143.0,<1.0",
    "uvicorn>=0.54.0,<1.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=9.1.1,<10.0",
    "pytest-asyncio>=1.4.0,<2.0",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
