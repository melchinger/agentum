# Multi-stage build for fullstack monorepo (Next.js + FastAPI)
# Stage 1: Build Next.js frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /workspace/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web ./
RUN npm run build

# Stage 2: Build Python backend with frontend assets
FROM python:3.12-slim
WORKDIR /app

# Install Node runtime (for potential server-side needs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && rm -rf /var/lib/apt/lists/*

# Copy root files
COPY pyproject.toml .
COPY package.json .

# Copy FastAPI backend
COPY apps/api ./apps/api

# Copy built Next.js to public directory (if needed)
COPY --from=frontend-builder /workspace/apps/web/.next ./public/.next
COPY --from=frontend-builder /workspace/apps/web/public ./public

# Setup Python dependencies
RUN pip install --no-cache-dir -e ./apps/api

# Expose ports
EXPOSE 8000 3000

# Start FastAPI (Next.js would be served separately or via nginx in production)
CMD ["uvicorn", "apps.api.src.{{PYTHON_PACKAGE}}.interfaces.http.app:app", "--host", "0.0.0.0", "--port", "8000"]
