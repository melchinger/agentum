# Multi-stage build for fullstack monorepo (Next.js + FastAPI)

# Stage 1: Build Next.js frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /workspace/apps/web
COPY apps/web/package.json apps/web/package-lock.json* apps/web/pnpm-lock.yaml* ./
RUN npm ci || (npm install -g pnpm && pnpm install)
COPY apps/web ./
RUN npm run build

# Stage 2: Python runtime with FastAPI
FROM python:3.12-slim
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy FastAPI backend files
COPY apps/api/pyproject.toml ./
RUN pip install --no-cache-dir -e .

# Copy source code
COPY apps/api/src ./src

# Copy built Next.js frontend
COPY --from=frontend-builder /workspace/apps/web/.next ./public/.next
COPY apps/web/public ./public/app 2>/dev/null || true

# Expose ports
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Start FastAPI server
CMD ["uvicorn", "{{PYTHON_PACKAGE}}.interfaces.http.app:app", "--host", "0.0.0.0", "--port", "8000"]
